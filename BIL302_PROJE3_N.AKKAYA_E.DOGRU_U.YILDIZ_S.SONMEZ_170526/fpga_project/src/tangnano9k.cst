// Tang Nano 9K Pin Atamaları
IO_LOC "clk" 52;
IO_PORT "clk" PULL_MODE=UP;

IO_LOC "rst_n" 4;
IO_PORT "rst_n" PULL_MODE=UP;

// Bilgisayardan gelen UART kablosunun takılacağı pin (Standart RX pini)
IO_LOC "uart_rx" 18; 
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// BİLGİSAYARA CEVAP VERECEĞİMİZ YENİ TX PİNİ (Kardeş Pin: 17)
IO_LOC "uart_tx" 17; 
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// 6 Adet Onboard LED
IO_LOC "led[0]" 10;
IO_LOC "led[1]" 11;
IO_LOC "led[2]" 13;
IO_LOC "led[3]" 14;
IO_LOC "led[4]" 15;
IO_LOC "led[5]" 16;