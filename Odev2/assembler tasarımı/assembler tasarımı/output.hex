0x0000 : 0x00A00093    # addi x1, x0, 10    # x1 = 10
0x0004 : 0x01400113    # addi x2, x0, 20    # x2 = 20
0x0008 : 0x002081B3    # add x3, x1, x2     # x3 = 30 (0x1E)
0x000C : 0x00108093    # addi x1, x1, 1     # x1'i 1 artır
0x0010 : 0xFE209EE3    # bne x1, x2, loop   # x1, x2'ye eşit değilse loop'a dallan
0x0014 : 0x00302023    # sw x3, x0, 0       # Sonucu belleğe yaz
